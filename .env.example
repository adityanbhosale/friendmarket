NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
SESSION_SECRET=replace-with-openssl-rand-base64-32

# Optional; used only by the hidden /slates prototype.
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com/markets

# Optional local iMessage agent. Keep real values only in .env.local.
# SIDEBAR_IMESSAGE_CONVERSATION_HASH=12-character-hash-from-smoke-or-evidence
# SIDEBAR_GROUP_ID=sidebar-group-uuid
# SIDEBAR_IMESSAGE_USER_MAP={"12-char-sender-hash":"sidebar-user-uuid"}
# For multiple groups, use this instead of the three values above:
# SIDEBAR_IMESSAGE_BINDINGS=[{"conversationHash":"12-char-hash","groupId":"group-uuid","users":{"sender-hash":"user-uuid"}}]
# SIDEBAR_GROUP_TIMEZONE=America/New_York
# Required for database-backed `Sidebar, start` onboarding:
# SIDEBAR_IMESSAGE_ID_SECRET=generate-with-openssl-rand-base64-32
# SIDEBAR_APP_URL=https://your-sidebar-deployment.example

# Optional only for ambiguous explicit requests; common requests parse locally.
# OPENAI_API_KEY=set-only-in-env-local-or-the-launching-shell
# OPENAI_INTENT_MODEL=gpt-5.4-nano
