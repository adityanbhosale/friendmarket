{
  "name": "sidebar-imessage-transport-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "smoke": "node src/photon-probe.mjs --smoke",
    "watch": "node src/photon-probe.mjs --watch",
    "watch:dry": "SIDEBAR_POC_DRY_RUN=1 node src/photon-probe.mjs --watch",
    "watch:self": "SIDEBAR_ALLOW_SELF_TEST=1 node --env-file-if-exists=../../.env.local src/photon-probe.mjs --watch",
    "watch:self:dry": "SIDEBAR_ALLOW_SELF_TEST=1 SIDEBAR_POC_DRY_RUN=1 node --env-file-if-exists=../../.env.local src/photon-probe.mjs --watch",
    "preflight:self": "SIDEBAR_ALLOW_SELF_TEST=1 node --env-file-if-exists=../../.env.local src/self-test-preflight.mjs",
    "agent": "node --env-file-if-exists=../../.env.local src/photon-agent.mjs",
    "agent:dry": "SIDEBAR_AGENT_DRY_RUN=1 node --env-file-if-exists=../../.env.local src/photon-agent.mjs",
    "agent:self": "SIDEBAR_ALLOW_SELF_TEST=1 node --env-file-if-exists=../../.env.local src/photon-agent.mjs",
    "agent:self:dry": "SIDEBAR_ALLOW_SELF_TEST=1 SIDEBAR_AGENT_DRY_RUN=1 node --env-file-if-exists=../../.env.local src/photon-agent.mjs"
  },
  "dependencies": {
    "@photon-ai/imessage-kit": "3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
